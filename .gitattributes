# Normaliza quebras de linha: o repositorio guarda LF
* text=auto eol=lf

# Scripts de shell precisam de LF para rodar no Linux (CI/Docker)
*.sh text eol=lf

# Scripts do Windows mantem CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: nunca converter
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.jar binary
